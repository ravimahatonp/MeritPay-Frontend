# Copy this file to .env.local and fill in real values.
#   cp .env.local.example .env.local
#
# All variables are exposed to the browser (NEXT_PUBLIC_ prefix). Do NOT put
# secrets here — only public contract IDs and public account addresses.
#
# The landing page and local-only proof demos work without these set.
# On-chain actions (fund pool, execute payroll, claim) require them.

# Payroll Soroban contract (starts with C, 56 chars)
NEXT_PUBLIC_PAYROLL_CONTRACT_ID=

# Claim Soroban contract (starts with C, 56 chars)
NEXT_PUBLIC_CLAIM_CONTRACT_ID=

# Groth16 verifier contract (starts with C, 56 chars)
NEXT_PUBLIC_VERIFIER_CONTRACT_ID=

# Contract admin wallet (starts with G, 56 chars).
# Required to execute payroll; the Verify page checks the connected wallet matches this.
NEXT_PUBLIC_ADMIN_ADDRESS=

# Source account used for read-only contract simulations (starts with G, 56 chars).
NEXT_PUBLIC_DEPLOYER_ADDRESS=

# Optional: set to 1 to enable verbose (non-sensitive) debug logging in the console.
# NEXT_PUBLIC_DEBUG=0
